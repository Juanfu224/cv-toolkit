.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store

# Última generación (el kit versiona .gitkeep + README)
cv/*
!cv/.gitkeep
!cv/README.md

# Defaults regenerables con `cvtool scaffold`
plantillas/cv_default_*.yaml

# Binarios de cada candidatura (el YAML de análisis sí se versiona)
candidaturas/**/*.pdf
candidaturas/**/*.docx
candidaturas/**/_extract.txt
